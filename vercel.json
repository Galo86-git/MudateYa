  "headers": [
    {
      "source": "/(.*\\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf|otf|mp4|webm))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(mudanzas-en-|fletes-en-|mudanza-sin-estres-|mudanza-completa-):rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(mudanceros|asesores|mya-mobility|relocation-clubes-de-futbol|relocation-colegios|relocation-cuerpo-diplomatico|relocation-vaca-muerta|contacto|circulo|membresia|terminos|privacidad)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(admin|admin-ia|admin-circulo|aliados|asesor-dashboard|asesor-login|asesor-registro|c21-altas|c21-importar|c21-registro|mudafy-importar|cobrar|mi-cuenta|mi-mudanza|mudafy-altas|mudafy-registro|r|registro|remax-altas|remax-registro|research-mudanceros|aceptar-terminos|inmobiliarias-registro|pago-exitoso|servicios|cliente-packs|mudancero-perfil|elegir|inmo-asesor-registro)(\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
